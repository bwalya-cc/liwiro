# Shared demo configuration for verun/vi demo scripts.
# Copy this file to verun/vi/demo/.env and configure both external services for
# the strict full-suite runner. Set VI_DEMO_ALLOW_MISSING_EXTERNAL=1 only for an
# explicitly local-only run in which SMTP/Cloudinary demos may report skips.

# VDB demos
VERUN_DEMO_VDB_USER=CHANGE_ME_VDB_USER
VERUN_DEMO_VDB_PASS=CHANGE_ME_VDB_PASSWORD
VERUN_DEMO_VDB_DOMAIN=vi_demos
VERUN_DEMO_VDB_DB=main

# Email demos
VERUN_DEMO_EMAIL_SMTP_HOST=smtp.gmail.com
VERUN_DEMO_EMAIL_SMTP_PORT=587
VERUN_DEMO_EMAIL_SMTP_STARTTLS=true
VERUN_DEMO_EMAIL_SMTP_SSL=false
VERUN_DEMO_EMAIL_SMTP_AUTH=true
VERUN_DEMO_EMAIL_SMTP_USERNAME=CHANGE_ME_EMAIL_USERNAME
VERUN_DEMO_EMAIL_SMTP_PASSWORD=CHANGE_ME_EMAIL_PASSWORD
VERUN_DEMO_EMAIL_FROM=CHANGE_ME_EMAIL_FROM
VERUN_DEMO_EMAIL_TO=CHANGE_ME_EMAIL_TO

# Cloudinary / MediaCloud demos
VERUN_DEMO_CLOUDINARY_ENABLED=false
VERUN_DEMO_CLOUDINARY_CLOUD_NAME=
VERUN_DEMO_CLOUDINARY_API_KEY=
VERUN_DEMO_CLOUDINARY_API_SECRET=
VERUN_DEMO_CLOUDINARY_FOLDER=liwiro-demo
