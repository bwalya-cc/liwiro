vdb import *;

func section(title: str) {
    print("\n=== " + title + " ===");
}

func showResult(label: str, res) {
    print("\n[" + label + "]");
    print("ok=" + str(res.ok) + " status=" + res.status + " op=" + res.operation);
    print("message=" + res.message);
    if (res.error != null) {
        print("error=" + res.error);
    }
    print("context=" + str(res.context));
    if (res.data != null) {
        print("data=" + str(res.data));
    }
}

try {
    section("Auth + Context");
    showResult("auth", vdb.auth({user: DEMO_VDB_USER, pass: DEMO_VDB_PASS}));
    showResult("set", vdb.set({domain: DEMO_VDB_DOMAIN, database: DEMO_VDB_DB}));

    section("Seed Data");
    let coll = vdb.collection("objects_demo");
    showResult("insert Alice", coll.insert({name: "Alice", meta: {city: "BBSR", score: 9}, tags: ["admin", "beta"]}));
    showResult("insert Bob", coll.insert({name: "Bob", meta: {city: "RKL", score: 7}, tags: ["user"]}));

    section("Fetch");
    let findRes = coll.find({}, 10);
    let rows = findRes.data;
    showResult("find all", findRes);
    print("rows type: " + type(rows));
    print("first row type: " + type(rows[0]));

    section("Dot notation");
    print("name: " + rows[0].name);
    print("city: " + rows[0].meta.city);

    section("Bracket notation");
    print("name: " + rows[0]["name"]);
    print("score: " + str(rows[0]["meta"]["score"]));

    section("Raw rows");
    print(rows);

    section("Cleanup");
    showResult("drop collection", vdb.drop("objects_demo"));
} catch (e) {
    print("VDB demo skipped: " + e.message);
}
