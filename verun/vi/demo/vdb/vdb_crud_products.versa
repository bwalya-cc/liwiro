vdb import *;

func section(title: str) {
    print("\n=== " + title + " ===");
}

func showResult(label: str, res) {
    print("\n[" + label + "]");
    print("ok=" + str(res.ok) + " status=" + res.status + " op=" + res.operation);
    print("message=" + res.message);
    if (res.error != null) {
        print("error=" + res.error);
    }
    print("context=" + str(res.context));
    if (res.data != null) {
        print("data=" + str(res.data));
    }
}

try {
    section("Auth + Context");
    showResult("auth", vdb.auth({user: DEMO_VDB_USER, pass: DEMO_VDB_PASS}));
    showResult("set", vdb.set({domain: DEMO_VDB_DOMAIN, database: DEMO_VDB_DB}));

    section("Insert Products");
    let products = vdb.collection("products_demo_1");
    showResult("insert laptop", products.insert({name: "Laptop", price: 999.99, stock: 10}));
    showResult("insert phone", products.insert({name: "Phone", price: 699.99, stock: 20}));

    section("Query + Update");
    let findRes = products.find({price: {$gt: 700}}, 20);
    showResult("find price > 700", findRes);

    let updRes = products.update({name: {$eq: "Laptop"}}, {stock: 8});
    showResult("update laptop stock", updRes);

    let verifyRes = products.find({name: {$eq: "Laptop"}}, 1);
    showResult("verify laptop", verifyRes);

    section("Cleanup");
    showResult("drop collection", vdb.drop("products_demo_1"));
} catch (e) {
    print("VDB demo skipped: " + e.message);
}
