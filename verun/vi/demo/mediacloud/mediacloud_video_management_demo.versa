filer import *;
import mediacloud;
demo/mediacloud/lib/mediacloud_demo_helpers import { section, skip, show_exception, show_pretty, show_result, assert_ok, show_provider_status, skip_blocked_environment };

let mediaDir = filer.join("demo", "mediacloud", "media");
let asset = {
  path: filer.join(mediaDir, "ba_kalulu.mp4"),
  filename: "ba_kalulu.mp4",
  mimeType: "video/mp4",
  publicId: "liwiro-mediacloud-ba-kalulu"
};

section("MediaCloud Cloudinary Video Management Demo");

let config = cloudinary_media_config;
if (config == null) {
  skip("Set VERUN_DEMO_CLOUDINARY_* in " + DEMO_ENV_FILE + " to run Cloudinary demos");
} else if (mediacloud.list == null || mediacloud.remove == null) {
  skip("cloudinary video management demo skipped because mediacloud.list/remove are not available in this build");
} else {
  show_provider_status("cloudinary", config);
  print("sourcePath=" + asset.path);

  try {
    let uploadResult = mediacloud.upload({
      provider: "cloudinary",
      config: config,
      body: {
        filename: asset.filename,
        mimeType: asset.mimeType,
        dataBase64: filer.read_bytes_base64(asset.path),
        publicId: asset.publicId,
        folder: "liwiro-demo"
      }
    });
    assert_ok("upload demo video", uploadResult);

    let listAfterUpload = mediacloud.list({
      provider: "cloudinary",
      config: config,
      resourceType: "video",
      prefix: uploadResult.storagePath,
      maxResults: 10
    });
    assert_ok("list uploaded demo video", listAfterUpload);
    if (listAfterUpload.count < 1) {
      throw "Expected at least one uploaded video after upload";
    }

    let deleteResult = mediacloud.remove({
      provider: "cloudinary",
      config: config,
      resourceType: "video",
      publicId: uploadResult.storagePath
    });
    assert_ok("delete uploaded demo video", deleteResult);

    let listAfterDelete = mediacloud.list({
      provider: "cloudinary",
      config: config,
      resourceType: "video",
      prefix: uploadResult.storagePath,
      maxResults: 10
    });
    assert_ok("confirm demo video deletion", listAfterDelete);
    if (listAfterDelete.count != 0) {
      throw "Expected zero videos after delete";
    }

    let reuploadResult = mediacloud.upload({
      provider: "cloudinary",
      config: config,
      body: {
        filename: asset.filename,
        mimeType: asset.mimeType,
        dataBase64: filer.read_bytes_base64(asset.path),
        publicId: asset.publicId,
        folder: "liwiro-demo"
      }
    });
    assert_ok("re-upload demo video", reuploadResult);

    show_pretty("Video management summary", {
      sourcePath: asset.path,
      firstUpload: {
        storagePath: uploadResult.storagePath,
        secureUrl: uploadResult.secureUrl
      },
      matchesAfterUpload: listAfterUpload.items,
      deleted: deleteResult.deleted,
      matchesAfterDelete: listAfterDelete.items,
      finalUpload: {
        storagePath: reuploadResult.storagePath,
        secureUrl: reuploadResult.secureUrl
      }
    });
  } catch (e) {
    if (!skip_blocked_environment("cloudinary video management demo", e)) {
      show_exception("cloudinary video management demo failed", e);
      throw e;
    }
  }
}
