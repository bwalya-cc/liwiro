time import *;

print("=== time module demo ===");
print(time.time());
print(time.time_ns());
print(time.perf_counter());
print(time.monotonic());
print(time.process_time());

let local = time.localtime();
let utc = time.gmtime();
print(local);
print(utc);
print(time.strftime("%Y-%m-%d %H:%M:%S", local));
print(time.ctime());

time.sleep(0.01);
print("slept");
