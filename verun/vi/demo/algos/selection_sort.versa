print("=== selection sort ===");
let arr = [64, 25, 12, 22, 11];

func selection_sort(a) {
    let n = leng(a);
    for (i in 0..(n - 2)) {
        let min_i = i;
        for (j in (i + 1)..(n - 1)) {
            if (a[j] < a[min_i]) {
                min_i = j;
            }
        }
        if (min_i != i) {
            let tmp = a[i];
            a[i] = a[min_i];
            a[min_i] = tmp;
        }
    }
    return a;
}

print(selection_sort(arr));
