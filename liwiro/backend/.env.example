# Liwiro backend example environment

LIWIRO_FRONTEND=http://127.0.0.1:3000
LIWIRO_BACKEND_PORT=5000

VDB_TRANSPORT=unixsocket
VDB_SERVER_URL=http://127.0.0.1:1957
VDB_HTTP_PORT=1957
VDB_UNIX_SOCKET_PATH=/tmp/vdb.sock
VDB_NAMED_PIPE_PATH=\\\\.\\pipe\\verun_vdb
VDB_USERNAME=liwiro
VDB_PASSWORD=change_me_vdb_app_password
LIWIRO_APP_USERNAME=Liwiro
LIWIRO_APP_PASSWORD=change_me_vdb_app_password
VDB_SUPER_ADMIN_USERNAME=change_me_super_admin
VDB_SUPER_ADMIN_PASSWORD=change_me_super_admin_password
LIWIRO_DOMAIN=liwiro
LIWIRO_DB=config

LIWIRO_VDB_AUTH_CONFIG=.runtime/liwiro.vdb.auth.json
LIWIRO_AUTH_PATH=.runtime/liwiro.vdb.auth.json
VDB_EXPORT_OUT_DIR=/tmp/vdb-exports

VI_PORTAL_SOURCE_DIR=../vi_portal_sources
VI_CUSTOM_MODULES_DIR=../../verun/vi/custom_modules

VERSE_ROOT=../verse
VERSE_DATA_DIR=../data/verse
AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5-mini
GOOGLE_API_KEY=your_google_api_key
GOOGLE_MODEL=gemini-3-flash-preview
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-sonnet-4-6

FLASK_DEBUG=true
