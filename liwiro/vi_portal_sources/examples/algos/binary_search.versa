print("=== binary search ===");
let arr = [1, 3, 5, 7, 9, 11, 13];

func binary_search(a, target) {
    let lo = 0;
    let hi = leng(a) - 1;
    while (lo <= hi) {
        let mid = int((lo + hi) / 2);
        if (a[mid] == target) {
            return mid;
        } else if (a[mid] < target) {
            lo = mid + 1;
        } else {
            hi = mid - 1;
        }
    }
    return -1;
}

print(binary_search(arr, 9));
print(binary_search(arr, 4));
