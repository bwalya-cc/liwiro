print("=== heap sort ===");

func heapify(arr, n, i) {
    let largest = i;
    let left = 2 * i + 1;
    let right = 2 * i + 2;

    if (left < n && arr[left] > arr[largest]) {
        largest = left;
    }
    if (right < n && arr[right] > arr[largest]) {
        largest = right;
    }

    if (largest != i) {
        arr.swap(i, largest);
        heapify(arr, n, largest);
    }
}

func heap_sort(arr) {
    let n = leng(arr);
    let i = (n // 2) - 1;
    while (i >= 0) {
        heapify(arr, n, i);
        i = i - 1;
    }

    let end = n - 1;
    while (end > 0) {
        arr.swap(0, end);
        heapify(arr, end, 0);
        end = end - 1;
    }
    return arr;
}

let arr = [12, 11, 13, 5, 6, 7];
print("input:");
print(arr);
print("sorted:");
print(heap_sort(arr));
