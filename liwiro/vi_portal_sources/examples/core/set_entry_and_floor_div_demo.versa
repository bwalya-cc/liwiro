print("=== Entry and set demo ===");

let d = { email: "alice@example.com", age: 31 };
let e = d.items()[0];
print(type(e));
print(e);
print(e.key());
print(e.value());
print(e.email);
print(e["email"]);

let s = set([1, 2, 2, 3, 4, 4, 5]);
print(type(s));
print(s);
print(s.size());
print(s.contains(3));
s.add(9);
s.remove(1);
print(s);
print(s.union(set([5, 6, 7])));
print(s.intersection(set([3, 4, 9, 10])));
print(s.difference(set([2, 9])));

print("=== floor division ===");
print(17 // 5);
print(17 // 3);
print(-17 // 3);
