# Interactive Educational Mad Libs

# Define the parts of speech with educational context
let terms = [
    { "type": "Noun", "def": "A person, place, thing, or idea.", "ex": "cat, mountain, freedom" },
    { "type": "Verb", "def": "An action or state of being.", "ex": "run, jump, think" },
    { "type": "Adjective", "def": "A word that describes a noun.", "ex": "blue, fast, happy" },
    { "type": "Adverb", "def": "A word that modifies a verb, adjective, or another adverb.", "ex": "quickly, very, loudly" }
];

let answers = {};

print("--- Educational Reference & Input ---");

# Loop through terms to show definitions and collect input
for (term : terms) {
    print(`{term.type}: {term.def}`);
    print(`Examples: {term.ex}`);
    
    # Use the built-in input function to get user values
    let userVal = input(`Enter a {term.type}: `);
    answers[term.type] = userVal;
    
    print("----------------------------");
}

print("\n--- Your Generated Story ---");

# Construct the story using backtick interpolation with the collected answers
let story = `The {answers.Adjective} {answers.Noun} decided to {answers.Verb} {answers.Adverb} through the system.`;

print(story);